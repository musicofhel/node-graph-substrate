direction: down

title: {
  label: WebSocket Protocol
  near: top-center
  shape: text
  style.font-size: 28
  style.bold: true
}

endpoint: "Single endpoint: ws://host:8080/ws/canvas/{graph_id}" {
  style.fill: "#313244"
  style.stroke: "#a6e3a1"
  style.font-color: "#cdd6f4"
}

client_to_server: "Client → Server (3 message types)" {
  shape: sql_table
  style.fill: "#1e1e2e"
  style.stroke: "#89b4fa"
  style.font-color: "#cdd6f4"
  compute_request: "request_id, node_id, inputs.config.prompt" {constraint: "trigger build()"}
  config_update: "node_id, config (JSONB patch)" {constraint: "persist + broadcast"}
  resubscribe: "subscriptions: [{stream, node_id}]" {constraint: "after reconnect"}
}

server_to_client: "Server → Client (6 message types)" {
  shape: sql_table
  style.fill: "#1e1e2e"
  style.stroke: "#a6e3a1"
  style.font-color: "#cdd6f4"
  graph_loaded: "graph_id, version, nodes[], edges[], manifests[]" {constraint: "on connect"}
  stream_event: "node_id, stream, cursor, payload, ts" {constraint: "from Redis"}
  computation_result: "request_id, node_id, ok, outputs/error" {constraint: "build() response"}
  node_state_updated: "node_id, data_patch (config change)" {constraint: "broadcast"}
  replay_gap: "node_id, stream, requested_from, earliest" {constraint: "cursor too old"}
  error: "code, message" {constraint: "parse/validation"}
}

validation: "All messages: JSON, validated via Pydantic discriminated unions" {
  style.fill: "#313244"
  style.stroke: "#585b70"
  style.font-color: "#cdd6f4"
}

endpoint -> client_to_server: "" {style.stroke: "#585b70"; style.stroke-width: 1}
client_to_server -> server_to_client: "" {style.stroke: "#585b70"; style.stroke-width: 1}
server_to_client -> validation: "" {style.stroke: "#585b70"; style.stroke-width: 1}
