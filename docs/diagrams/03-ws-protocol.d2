direction: right

title: {
  label: WebSocket Protocol
  near: top-center
  shape: text
  style.font-size: 28
  style.bold: true
}

client: Browser {
  style.fill: "#1e1e2e"
  style.stroke: "#89b4fa"
  style.font-color: "#cdd6f4"
}

server: FastAPI WS {
  style.fill: "#1e1e2e"
  style.stroke: "#a6e3a1"
  style.font-color: "#cdd6f4"
}

client_msgs: "Client → Server" {
  style.fill: "#11111b"
  style.stroke: "#89b4fa"
  style.font-color: "#cdd6f4"

  compute: ComputeRequest {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
    label: |md
      **ComputeRequest**
      ```json
      {
        "type": "compute_request",
        "request_id": "abc123",
        "node_id": "prompt-1",
        "inputs": { "config": { "prompt": "..." } }
      }
      ```
    |
  }

  config: ConfigUpdateMsg {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
    label: |md
      **ConfigUpdateMsg**
      ```json
      {
        "type": "config_update",
        "node_id": "prompt-1",
        "config": { "prompt": "new text" }
      }
      ```
    |
  }

  resub: Resubscribe {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
    label: |md
      **Resubscribe**
      ```json
      {
        "type": "resubscribe",
        "subscriptions": [
          { "stream": "topoconf:scoring:...", "node_id": "cloud-1" }
        ]
      }
      ```
    |
  }
}

server_msgs: "Server → Client" {
  style.fill: "#11111b"
  style.stroke: "#a6e3a1"
  style.font-color: "#cdd6f4"

  loaded: GraphLoaded {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
    label: |md
      **GraphLoaded** (on connect)
      ```json
      {
        "type": "graph_loaded",
        "graph_id": "uuid",
        "version": 3,
        "nodes": [...],
        "edges": [...],
        "manifests": [...]
      }
      ```
    |
  }

  stream: StreamEvent {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
    label: |md
      **StreamEvent** (from Redis)
      ```json
      {
        "type": "stream_event",
        "node_id": "cloud-1",
        "stream": "topoconf:scoring:...",
        "cursor": "1715000000000-0",
        "payload": { ... },
        "ts": 1715000000.0
      }
      ```
    |
  }

  result: ComputationResult {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
    label: |md
      **ComputationResult**
      ```json
      {
        "type": "computation_result",
        "request_id": "abc123",
        "node_id": "prompt-1",
        "ok": true,
        "outputs": { "features": {...} }
      }
      ```
    |
  }

  state: NodeStateUpdated {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
    label: |md
      **NodeStateUpdated**
      ```json
      {
        "type": "node_state_updated",
        "node_id": "prompt-1",
        "data_patch": { "config": {...} }
      }
      ```
    |
  }

  error: ErrorMsg {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
    label: |md
      **ErrorMsg**
      ```json
      {
        "type": "error",
        "code": "parse_error",
        "message": "..."
      }
      ```
    |
  }

  replay_gap: ReplayGap {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
    label: |md
      **ReplayGap**
      ```json
      {
        "type": "replay_gap",
        "node_id": "cloud-1",
        "stream": "topoconf:scoring:...",
        "requested_from": "0-0",
        "earliest_available": "1715000000000-0"
      }
      ```
    |
  }
}

client -> client_msgs
server -> server_msgs
