direction: down

title: {
  label: "Data Flow: Compute Path (Request/Response)"
  near: top-center
  shape: text
  style.font-size: 28
  style.bold: true
}

step1: "1. User types prompt, clicks Analyze" {
  shape: step
  style.fill: "#313244"
  style.stroke: "#89b4fa"
  style.font-color: "#cdd6f4"
}

step2: "2. PromptInputNode dispatches CustomEvent" {
  shape: step
  style.fill: "#313244"
  style.stroke: "#89b4fa"
  style.font-color: "#cdd6f4"
}

step3: "3. App.tsx sets node status to computing" {
  shape: step
  style.fill: "#313244"
  style.stroke: "#f9e2af"
  style.font-color: "#cdd6f4"
}

step4: "4. SubstrateWS.send() ComputeRequest via WS" {
  shape: step
  style.fill: "#313244"
  style.stroke: "#a6e3a1"
  style.font-color: "#cdd6f4"
}

step5: "5. FastAPI WS handler parses ComputeRequest" {
  shape: step
  style.fill: "#313244"
  style.stroke: "#a6e3a1"
  style.font-color: "#cdd6f4"
}

step6: "6. handle_compute_request: await component.build()" {
  shape: step
  style.fill: "#313244"
  style.stroke: "#cba6f7"
  style.font-color: "#cdd6f4"
}

step7: "7. PromptInputComponent.build() publishes to topoconf:control" {
  shape: step
  style.fill: "#313244"
  style.stroke: "#cba6f7"
  style.font-color: "#cdd6f4"
}

step8: "8. Server sends computation_result (ok: true)" {
  shape: step
  style.fill: "#313244"
  style.stroke: "#a6e3a1"
  style.font-color: "#cdd6f4"
}

step9: "9. App.tsx handleMessage: status idle, fan-out features" {
  shape: step
  style.fill: "#313244"
  style.stroke: "#89b4fa"
  style.font-color: "#cdd6f4"
}

step10: "10. batchUpdateNodeData: React re-renders nodes" {
  shape: step
  style.fill: "#313244"
  style.stroke: "#89b4fa"
  style.font-color: "#cdd6f4"
}

step1 -> step2: "" {style.stroke-width: 2}
step2 -> step3: "" {style.stroke-width: 2}
step3 -> step4: "" {style.stroke-width: 2}
step4 -> step5: "" {style.stroke-width: 2}
step5 -> step6: "" {style.stroke-width: 2}
step6 -> step7: "" {style.stroke-width: 2}
step7 -> step8: "" {style.stroke-width: 2}
step8 -> step9: "" {style.stroke-width: 2}
step9 -> step10: "" {style.stroke-width: 2}

step10 -> guards: "" {style.stroke: "#f38ba8"; style.stroke-width: 2; style.stroke-dash: 3}

guards: Guard Rails {
  style.fill: "#11111b"
  style.stroke: "#f38ba8"
  style.font-color: "#cdd6f4"

  g1: "SUBSCRIBER node: returns ok: false (cannot compute)" {
    style.fill: "#313244"
    style.font-color: "#f38ba8"
  }
  g2: "Unknown node: dynamic instantiation from graph metadata" {
    style.fill: "#313244"
    style.font-color: "#f9e2af"
  }
  g3: "build() throws: returns ok: false with error message" {
    style.fill: "#313244"
    style.font-color: "#f38ba8"
  }
  g4: "WS not OPEN: send() returns false, status set to error" {
    style.fill: "#313244"
    style.font-color: "#f38ba8"
  }
  g1 -> g2: "" {style.stroke: "#585b70"; style.stroke-width: 1}
  g2 -> g3: "" {style.stroke: "#585b70"; style.stroke-width: 1}
  g3 -> g4: "" {style.stroke: "#585b70"; style.stroke-width: 1}
}
