direction: down

title: {
  label: "Data Flow: Subscriber Path"
  near: top-center
  shape: text
  style.font-size: 28
  style.bold: true
  style.font-color: "#cdd6f4"
}

sources: "Data Sources" {
  style.fill: "#11111b"
  style.stroke: "#585b70"
  style.font-color: "#cdd6f4"

  daemon: "TopoConf Daemon\nscoring pipeline → 7 scoring streams" {
    style.fill: "#1e1e2e"
    style.stroke: "#cba6f7"
    style.font-color: "#cdd6f4"
  }

  linkforge: "LinkForge Bot\n10-stage waterfall + AutoRel sweeps" {
    style.fill: "#1e1e2e"
    style.stroke: "#fab387"
    style.font-color: "#cdd6f4"
  }

  research: "Research Pipeline\n5-stage lifecycle (triage → promote)" {
    style.fill: "#1e1e2e"
    style.stroke: "#a6e3a1"
    style.font-color: "#cdd6f4"
  }
}

redis: "Redis Streams (24 total)" {
  style.fill: "#1e1e2e"
  style.stroke: "#f38ba8"
  style.font-color: "#cdd6f4"
  shape: cylinder
}

hub: "StreamHub" {
  style.fill: "#1e1e2e"
  style.stroke: "#f9e2af"
  style.font-color: "#cdd6f4"

  readers: "Per-tier reader tasks\nXREAD BLOCK (interactive / background)" {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }
  fanout: "Fan-out to all\nsubscribed WebSockets" {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }
  readers -> fanout: "per-node addressing" {
    style.stroke-width: 2
    style.font-color: "#cdd6f4"
  }
}

ws: "WebSocket → Browser" {
  style.fill: "#1e1e2e"
  style.stroke: "#a6e3a1"
  style.font-color: "#cdd6f4"

  send: "stream_event messages\nper-node addressing" {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }
}

client: "Browser Client" {
  style.fill: "#1e1e2e"
  style.stroke: "#89b4fa"
  style.font-color: "#cdd6f4"

  throttle: "500ms throttled flush\n(replaces per-frame RAF)" {
    style.fill: "#313244"
    style.stroke: "#f9e2af"
    style.font-color: "#cdd6f4"
  }
  store: "Zustand canvas-store\nbatchUpdateNodeData()" {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }

  pipeline_nodes: "Scoring Nodes (7)\ngauge, bars, cloud, diagram\nmonitor, waterfall, breathing" {
    style.fill: "#313244"
    style.stroke: "#cba6f7"
    style.font-color: "#cdd6f4"
  }
  lf_nodes: "LinkForge Nodes (5)\ncoordinator, stats\nautorel, stage, bridge" {
    style.fill: "#313244"
    style.stroke: "#fab387"
    style.font-color: "#cdd6f4"
  }
  research_nodes: "Research Node (1)\nresearch_coordinator" {
    style.fill: "#313244"
    style.stroke: "#a6e3a1"
    style.font-color: "#cdd6f4"
  }

  throttle -> store: "" {style.stroke-width: 2}
  store -> pipeline_nodes: "useNodesData(id)" {style.stroke-width: 2; style.font-color: "#cdd6f4"; style.stroke: "#cba6f7"}
  store -> lf_nodes: "useNodesData(id)" {style.stroke-width: 2; style.font-color: "#cdd6f4"; style.stroke: "#fab387"}
  store -> research_nodes: "useNodesData(id)" {style.stroke-width: 2; style.font-color: "#cdd6f4"; style.stroke: "#a6e3a1"}
}

sources.daemon -> redis: "XADD × 7" {style.stroke: "#cba6f7"; style.stroke-width: 2; style.font-color: "#cdd6f4"}
sources.linkforge -> redis: "XADD × 11" {style.stroke: "#fab387"; style.stroke-width: 2; style.font-color: "#cdd6f4"}
sources.research -> redis: "XADD × 5" {style.stroke: "#a6e3a1"; style.stroke-width: 2; style.font-color: "#cdd6f4"}
redis -> hub.readers: "XREAD BLOCK" {style.stroke: "#f38ba8"; style.stroke-width: 2; style.font-color: "#cdd6f4"}
hub.fanout -> ws.send: "per-node msg" {style.stroke: "#a6e3a1"; style.stroke-width: 2; style.font-color: "#cdd6f4"}
ws.send -> client.throttle: "onmessage" {style.stroke: "#89b4fa"; style.stroke-width: 2; style.font-color: "#cdd6f4"}
