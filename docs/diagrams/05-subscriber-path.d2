direction: right

title: {
  label: "Data Flow: Subscriber Path (Redis Streams → React Nodes)"
  near: top-center
  shape: text
  style.font-size: 28
  style.bold: true
}

sources: Data Sources {
  style.fill: "#11111b"
  style.stroke: "#585b70"
  style.font-color: "#cdd6f4"

  daemon: TopoConf Daemon {
    style.fill: "#1e1e2e"
    style.stroke: "#cba6f7"
    style.font-color: "#cdd6f4"

    s1: "hidden states" {style.fill: "#313244"; style.font-color: "#cdd6f4"}
    s2: "PCA + cluster" {style.fill: "#313244"; style.font-color: "#cdd6f4"}
    s3: "persistence PH" {style.fill: "#313244"; style.font-color: "#cdd6f4"}
    s4: "13 features" {style.fill: "#313244"; style.font-color: "#cdd6f4"}
    s5: "confidence" {style.fill: "#313244"; style.font-color: "#cdd6f4"}
    s6: "bridge health" {style.fill: "#313244"; style.font-color: "#cdd6f4"}
    s7: "explain" {style.fill: "#313244"; style.font-color: "#cdd6f4"}
    s1 -> s2 -> s3 -> s4 -> s5 -> s6 -> s7
  }

  linkforge: LinkForge Bot {
    style.fill: "#1e1e2e"
    style.stroke: "#fab387"
    style.font-color: "#cdd6f4"

    ingest: "Paper ingestion\n10-stage waterfall" {style.fill: "#313244"; style.font-color: "#cdd6f4"}
    autorel: "AutoRel sweeps" {style.fill: "#313244"; style.font-color: "#cdd6f4"}
    ingest -> autorel
  }

  research: Research Pipeline {
    style.fill: "#1e1e2e"
    style.stroke: "#a6e3a1"
    style.font-color: "#cdd6f4"

    lifecycle: "5-stage lifecycle\ntriage → promote" {style.fill: "#313244"; style.font-color: "#cdd6f4"}
  }
}

redis: Redis Streams {
  style.fill: "#1e1e2e"
  style.stroke: "#f38ba8"
  style.font-color: "#cdd6f4"
  shape: cylinder

  topo_streams: "topoconf:scoring:*\n6 streams" {
    style.fill: "#313244"
    style.font-color: "#cba6f7"
  }
  lf_streams: "linkforge:*\n10 streams" {
    style.fill: "#313244"
    style.font-color: "#fab387"
  }
  autorel_stream: "linkforge:autorel:*\n1 stream" {
    style.fill: "#313244"
    style.font-color: "#fab387"
  }
  research_streams: "topoconf:research:*\n5 streams" {
    style.fill: "#313244"
    style.font-color: "#a6e3a1"
  }
  control: "topoconf:control\n1 stream" {
    style.fill: "#313244"
    style.font-color: "#585b70"
  }
}

hub: StreamHub {
  style.fill: "#1e1e2e"
  style.stroke: "#f9e2af"
  style.font-color: "#cdd6f4"

  readers: "1 asyncio.Task\nper stream (23 total)\nXREAD BLOCK 5000" {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }
  fanout: "Fan-out to\nall subscribed\nWebSockets" {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }
  readers -> fanout
}

ws: WebSocket {
  style.fill: "#1e1e2e"
  style.stroke: "#a6e3a1"
  style.font-color: "#cdd6f4"

  send: "stream_event\nmessages" {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }
}

client: Browser {
  style.fill: "#1e1e2e"
  style.stroke: "#89b4fa"
  style.font-color: "#cdd6f4"

  raf: "RAF Coalescing\nbatch per frame" {
    style.fill: "#313244"
    style.stroke: "#f9e2af"
    style.font-color: "#cdd6f4"
  }
  store: "Zustand Store\nbatchUpdateNodeData()" {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }

  pipeline_nodes: "Pipeline Nodes (6)\nhidden_state_cloud, persistence_diagram\nfeature_bars, confidence_gauge\nbridge_monitor, explain_waterfall" {
    style.fill: "#313244"
    style.font-color: "#cba6f7"
  }
  lf_nodes: "LinkForge Nodes (5)\nlf_coordinator, lf_stats\nlf_autorel, lf_stage\nresearch_bridge" {
    style.fill: "#313244"
    style.font-color: "#fab387"
  }
  research_nodes: "Research Node (1)\nresearch_coordinator" {
    style.fill: "#313244"
    style.font-color: "#a6e3a1"
  }

  raf -> store
  store -> pipeline_nodes
  store -> lf_nodes
  store -> research_nodes
}

sources.daemon -> redis.topo_streams: "XADD × 6" {style.stroke: "#cba6f7"}
sources.linkforge.ingest -> redis.lf_streams: "XADD × 10" {style.stroke: "#fab387"}
sources.linkforge.autorel -> redis.autorel_stream: XADD {style.stroke: "#fab387"}
sources.research -> redis.research_streams: "XADD × 5" {style.stroke: "#a6e3a1"}

redis -> hub.readers: "XREAD\nBLOCK" {style.stroke: "#f38ba8"}
hub.fanout -> ws.send: "per-node\nmessage" {style.stroke: "#a6e3a1"}
ws.send -> client.raf: "onmessage" {style.stroke: "#89b4fa"}
