direction: down

title: {
  label: Graph CRUD Lifecycle
  near: top-center
  shape: text
  style.font-size: 28
  style.bold: true
}

first_visit: First Visit {
  style.fill: "#1e1e2e"
  style.stroke: "#89b4fa"
  style.font-color: "#cdd6f4"

  check: "Check URL ?graph= param\nor localStorage cache" {
    shape: step
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }
  create_proj: "POST /api/projects\n{slug: 'default'}" {
    shape: step
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }
  create_graph: "POST /api/graphs\n{project_id, name}" {
    shape: step
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }
  seed: "Seed per-canvas nodes\n(Pipeline: 7, Research: 4, R2: 5)" {
    shape: step
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }
  save: "saveGraph() →\nPATCH /api/graphs/{id}/ops" {
    shape: step
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }

  check -> create_proj: "no cached ID"
  create_proj -> create_graph -> seed -> save
}

load: Load Graph {
  style.fill: "#1e1e2e"
  style.stroke: "#a6e3a1"
  style.font-color: "#cdd6f4"

  fetch: "GET /api/graphs/{id}\nfetch nodes + edges + version" {
    shape: step
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }
  hydrate: "Hydrate Zustand store\nmap DB rows → RF Nodes/Edges" {
    shape: step
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }
  track: "Track _serverNodeIds\n_serverEdgeIds for diff" {
    shape: step
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }

  fetch -> hydrate -> track
}

save_flow: Save Graph {
  style.fill: "#1e1e2e"
  style.stroke: "#f9e2af"
  style.font-color: "#cdd6f4"

  diff: "Diff current vs server IDs\ncompute remove_node/remove_edge ops" {
    shape: step
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }
  build_ops: "Build ops array:\n[remove_*, upsert_node, upsert_edge]" {
    shape: step
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }
  patch: "PATCH /api/graphs/{id}/ops\n{expected_version, ops}" {
    shape: step
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }
  version: "Server: SELECT FOR UPDATE\ncheck version → apply ops\n→ bump version → snapshot" {
    shape: step
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }
  update: "Update local\ngraphVersion + server ID sets" {
    shape: step
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }

  diff -> build_ops -> patch -> version -> update
}

conflict: Version Conflict (409) {
  style.fill: "#1e1e2e"
  style.stroke: "#f38ba8"
  style.font-color: "#cdd6f4"

  detect: "Server version != expected_version\nOptimisticLockError raised" {
    shape: step
    style.fill: "#313244"
    style.font-color: "#f38ba8"
  }
  respond: "HTTP 409\n{current_version, current_state}" {
    shape: step
    style.fill: "#313244"
    style.font-color: "#f38ba8"
  }
  reload: "Client: loadGraph()\nre-sync from server state" {
    shape: step
    style.fill: "#313244"
    style.font-color: "#f9e2af"
  }

  detect -> respond -> reload
}

first_visit -> load: "next visit"
save_flow.patch -> conflict.detect: "version mismatch" {style.stroke: "#f38ba8"; style.stroke-dash: 3}
