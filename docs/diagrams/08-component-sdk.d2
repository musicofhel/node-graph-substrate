direction: down

title: {
  label: Backend Component SDK
  near: top-center
  shape: text
  style.font-size: 28
  style.bold: true
}

enums: Enums {
  style.fill: "#1e1e2e"
  style.stroke: "#585b70"
  style.font-color: "#cdd6f4"

  socket_type: "SocketType (str Enum)\nPROMPT EXTRACTION FEATURES\nCONFIDENCE BRIDGE_HEALTH\nEXPLANATION DIAGRAMS" {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }

  node_kind: "NodeKind (str Enum)\nCOMPUTED SUBSCRIBER" {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }
}

socket: "Socket (dataclass)\nid str\ntype SocketType\nlabel str" {
  style.fill: "#1e1e2e"
  style.stroke: "#89b4fa"
  style.font-color: "#cdd6f4"
}

manifest: "ComponentManifest (dataclass)\ntype_id kind label category\ninputs/outputs list of Socket\nsubscribed_streams list of str\nconfig_fields list of dict" {
  style.fill: "#1e1e2e"
  style.stroke: "#f9e2af"
  style.font-color: "#cdd6f4"
}

base: "Component (base class)\n\nClass: type_id kind label category\n  inputs outputs subscribed_streams\n\nInstance: node_id config\n\nMethods: manifest() on_init()\n  build(**inputs) on_event()\n  on_config_change() on_destroy()" {
  style.fill: "#1e1e2e"
  style.stroke: "#a6e3a1"
  style.font-color: "#cdd6f4"
}

registry_cls: "ComponentRegistry\n\nregister(cls) - decorator\nget(type_id) - lookup\nmanifests() - all manifests\ncreate_instance(type_id node_id config)" {
  style.fill: "#1e1e2e"
  style.stroke: "#cba6f7"
  style.font-color: "#cdd6f4"
}

impls: Implementations {
  style.fill: "#1e1e2e"
  style.stroke: "#f38ba8"
  style.font-color: "#cdd6f4"

  pi: "PromptInputComponent\nCOMPUTED" {
    style.fill: "#313244"
    style.font-color: "#89b4fa"
  }
  fb: "FeatureBarsComponent\nSUBSCRIBER features_computed" {
    style.fill: "#313244"
    style.font-color: "#22d3ee"
  }
  hsc: "HiddenStateCloudComponent\nSUBSCRIBER hidden_state_cloud" {
    style.fill: "#313244"
    style.font-color: "#3b82f6"
  }
  pd: "PersistenceDiagramComponent\nSUBSCRIBER persistence_computed" {
    style.fill: "#313244"
    style.font-color: "#a78bfa"
  }
  cg: "ConfidenceGaugeComponent\nSUBSCRIBER confidence_scored" {
    style.fill: "#313244"
    style.font-color: "#4ade80"
  }
  bm: "BridgeMonitorComponent\nSUBSCRIBER bridge_health" {
    style.fill: "#313244"
    style.font-color: "#fbbf24"
  }
  ew: "ExplainWaterfallComponent\nSUBSCRIBER explain_result" {
    style.fill: "#313244"
    style.font-color: "#f87171"
  }
}

enums.socket_type -> socket
socket -> manifest
enums.node_kind -> manifest
base -> manifest: "classmethod manifest()"
base -> impls: extends {style.stroke-dash: 3}
impls -> registry_cls: "@registry.register" {style.stroke: "#cba6f7"}
