direction: down

title: {
  label: "Backend Component SDK"
  near: top-center
  shape: text
  style.font-size: 28
  style.bold: true
}

enums: "Enums" {
  style.fill: "#1e1e2e"
  style.stroke: "#585b70"
  style.font-color: "#cdd6f4"

  socket_type: "SocketType (str Enum)\nPROMPT, EXTRACTION, FEATURES\nCONFIDENCE, BRIDGE_HEALTH\nEXPLANATION, DIAGRAMS" {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }

  node_kind: "NodeKind (str Enum)\nCOMPUTED, SUBSCRIBER" {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }
}

socket: "Socket (dataclass)\nid: str, type: SocketType, label: str" {
  style.fill: "#1e1e2e"
  style.stroke: "#89b4fa"
  style.font-color: "#cdd6f4"
}

manifest: "ComponentManifest (dataclass)\ntype_id, kind, label, category\ninputs/outputs: list[Socket]\nsubscribed_streams: list[str]\nconfig_fields: list[dict]" {
  style.fill: "#1e1e2e"
  style.stroke: "#f9e2af"
  style.font-color: "#cdd6f4"
}

base: "Component (base class)\n\nClass attrs: type_id, kind, label, category\n  inputs, outputs, subscribed_streams\n\nMethods: manifest(), build(**inputs)\n  on_init(), on_event(), on_config_change()\n  on_destroy()" {
  style.fill: "#1e1e2e"
  style.stroke: "#a6e3a1"
  style.font-color: "#cdd6f4"
}

registry: "ComponentRegistry\nregister(cls) — decorator\nget(type_id) — lookup\nmanifests() — all manifests\ncreate_instance(type_id, node_id, config)" {
  style.fill: "#1e1e2e"
  style.stroke: "#cba6f7"
  style.font-color: "#cdd6f4"
}

impls: "Registered Implementations (13)" {
  shape: sql_table
  style.fill: "#1e1e2e"
  style.stroke: "#f38ba8"
  style.font-color: "#cdd6f4"
  PromptInputComponent: "COMPUTED — input" {constraint: "topoconf"}
  HiddenStateCloudComponent: "SUBSCRIBER — extraction" {constraint: "topoconf"}
  FeatureBarsComponent: "SUBSCRIBER — topology" {constraint: "topoconf"}
  PersistenceDiagramComponent: "SUBSCRIBER — topology" {constraint: "topoconf"}
  ConfidenceGaugeComponent: "SUBSCRIBER — scoring" {constraint: "topoconf"}
  BridgeMonitorComponent: "SUBSCRIBER — scoring" {constraint: "topoconf"}
  ExplainWaterfallComponent: "SUBSCRIBER — scoring" {constraint: "topoconf"}
  DriftMatrixComponent: "SUBSCRIBER — scoring (local)" {constraint: "topoconf"}
  LfCoordinatorComponent: "SUBSCRIBER — coordination" {constraint: "linkforge"}
  LfStatsComponent: "SUBSCRIBER — metrics" {constraint: "linkforge"}
  LfAutoRelComponent: "SUBSCRIBER — metrics" {constraint: "linkforge"}
  ResearchBridgeComponent: "SUBSCRIBER — coordination" {constraint: "research"}
  ResearchCoordinatorComponent: "SUBSCRIBER — coordination" {constraint: "research"}
}

enums.socket_type -> socket: "" {style.stroke-width: 2; style.stroke: "#585b70"}
enums.node_kind -> manifest: "" {style.stroke-width: 2; style.stroke: "#585b70"}
socket -> manifest: "" {style.stroke-width: 2; style.stroke: "#89b4fa"}
base -> manifest: "classmethod manifest()" {style.stroke-width: 2; style.font-color: "#cdd6f4"; style.stroke: "#a6e3a1"}
base -> impls: "extends" {style.stroke-width: 2; style.stroke-dash: 3; style.font-color: "#cdd6f4"; style.stroke: "#f38ba8"}
impls -> registry: "@registry.register" {style.stroke-width: 2; style.font-color: "#cdd6f4"; style.stroke: "#cba6f7"}
