direction: down

title: {
  label: "Redis Streams — 23 Streams"
  near: top-center
  shape: text
  style.font-size: 28
  style.bold: true
  style.font-color: "#cdd6f4"
}

control: "Control Channel (1 stream)" {
  shape: sql_table
  style.fill: "#1e1e2e"
  style.stroke: "#585b70"
  style.font-color: "#cdd6f4"
  topoconf_control: "Server → Daemon: {command, prompt, run_id} ~1KB" {constraint: "→ daemon"}
}

scoring: "TopoConf Scoring (6 streams)" {
  shape: sql_table
  style.fill: "#1e1e2e"
  style.stroke: "#cba6f7"
  style.font-color: "#cdd6f4"
  hidden_state_cloud: "{umap_3d (Nx3), clusters, bridge_idx} ~40KB" {constraint: "scoring"}
  persistence_computed: "{H0, H1, H2 birth-death pairs} ~5KB" {constraint: "scoring"}
  features_computed: "{features: {name: value} x 13} ~1KB" {constraint: "scoring"}
  confidence_scored: "{confidence, mode} ~0.5KB" {constraint: "scoring"}
  bridge_health: "{healthy, bridge_at_pos0, silhouette_by_layer} ~1KB" {constraint: "scoring"}
  explain_result: "{features: {raw, scaled, coef, contrib}} ~2KB" {constraint: "scoring"}
}

linkforge: "LinkForge Ingestion (10 streams)" {
  shape: sql_table
  style.fill: "#1e1e2e"
  style.stroke: "#fab387"
  style.font-color: "#cdd6f4"
  ingested: "{paper_id, url, title, source}" {constraint: "linkforge"}
  extracted: "{paper_id, abstract, authors, year}" {constraint: "linkforge"}
  categorized: "{paper_id, categories, relevance}" {constraint: "linkforge"}
  embedded: "{paper_id, vector_dim, model}" {constraint: "linkforge"}
  stored: "{paper_id, neo4j_id}" {constraint: "linkforge"}
  chunked: "{paper_id, chunk_count}" {constraint: "linkforge"}
  auto_related: "{paper_id, related_ids, scores}" {constraint: "linkforge"}
  research_bridged: "{paper_id, triage_candidate}" {constraint: "linkforge"}
  url_discovered: "{url, source, context}" {constraint: "linkforge"}
  completed: "{paper_id, duration_ms, stages_ok}" {constraint: "linkforge"}
}

autorel: "LinkForge AutoRel (1 stream)" {
  shape: sql_table
  style.fill: "#1e1e2e"
  style.stroke: "#f38ba8"
  style.font-color: "#cdd6f4"
  sweep_completed: "{sweep_id, papers_scored, new_relations, duration_ms}" {constraint: "autorel"}
}

research: "Research Lifecycle (5 streams)" {
  shape: sql_table
  style.fill: "#1e1e2e"
  style.stroke: "#a6e3a1"
  style.font-color: "#cdd6f4"
  triaged: "{paper_id, priority, rationale}" {constraint: "research"}
  script_generated: "{paper_id, script_path}" {constraint: "research"}
  experiment_started: "{paper_id, run_id, gpu}" {constraint: "research"}
  experiment_completed: "{paper_id, run_id, metrics}" {constraint: "research"}
  promoted: "{paper_id, target_pathway}" {constraint: "research"}
}

config: "Stream Configuration" {
  style.fill: "#313244"
  style.stroke: "#585b70"
  style.font-color: "#cdd6f4"
  label: "Stream Configuration\n\nAll 23 streams: MAXLEN ~ 10000\nPlain XREAD (not XREADGROUP) — broadcast\nPayload field: \"data\" (JSON string)\nMax payload: 256 KB assertion"
}

control -> scoring: "" {style.stroke: "#585b70"; style.stroke-width: 1}
scoring -> linkforge: "" {style.stroke: "#585b70"; style.stroke-width: 1}
linkforge -> autorel: "" {style.stroke: "#585b70"; style.stroke-width: 1}
autorel -> research: "" {style.stroke: "#585b70"; style.stroke-width: 1}
research -> config: "" {style.stroke: "#585b70"; style.stroke-width: 1}
