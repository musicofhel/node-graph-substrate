direction: down

title: {
  label: Frontend Component Tree
  near: top-center
  shape: text
  style.font-size: 28
  style.bold: true
}

app: "App.tsx\nGraph init + WS lifecycle\ncompute_request + result fan-out" {
  style.fill: "#1e1e2e"
  style.stroke: "#89b4fa"
  style.font-color: "#cdd6f4"
}

tabbar: "TabBar\nPipeline / Research / Research v2\nPer-canvas node filtering + seeding" {
  style.fill: "#1e1e2e"
  style.stroke: "#cba6f7"
  style.font-color: "#cdd6f4"
}

splitpane: "SplitPane\nTop: SubstrateCanvas\nBottom: PaperPool (Research canvases)" {
  style.fill: "#1e1e2e"
  style.stroke: "#585b70"
  style.font-color: "#cdd6f4"
}

canvas_wrapper: SubstrateCanvas {
  style.fill: "#1e1e2e"
  style.stroke: "#a6e3a1"
  style.font-color: "#cdd6f4"

  palette: "NodePalette\nFilters by canvas type\nDrag-to-add" {
    style.fill: "#313244"
    style.stroke: "#cba6f7"
    style.font-color: "#cdd6f4"
  }

  rf: ReactFlow {
    style.fill: "#313244"
    style.stroke: "#a6e3a1"
    style.font-color: "#cdd6f4"

    bg: Background {style.fill: "#45475a"; style.font-color: "#cdd6f4"}
    controls: Controls {style.fill: "#45475a"; style.font-color: "#cdd6f4"}
    minimap: MiniMap {style.fill: "#45475a"; style.font-color: "#cdd6f4"}
  }

  canvas_ctrl: "CanvasControls\nSave / Load / Layout" {
    style.fill: "#313244"
    style.stroke: "#f9e2af"
    style.font-color: "#cdd6f4"
  }

  timeline: "PipelineTimeline\nLinkForge stage timeline" {
    style.fill: "#313244"
    style.stroke: "#fab387"
    style.font-color: "#cdd6f4"
  }

  detail: "DetailPanel (420px sidebar)\n4 tabs: Overview / Series / Config / Drift\nPer-node content" {
    style.fill: "#313244"
    style.stroke: "#f38ba8"
    style.font-color: "#cdd6f4"
  }

  eventlog: "EventLog\nReal-time stream inspector" {
    style.fill: "#313244"
    style.stroke: "#f9e2af"
    style.font-color: "#cdd6f4"
  }
}

nodes: "Custom Nodes — 20 types (all memo'd)" {
  style.fill: "#1e1e2e"
  style.stroke: "#f38ba8"
  style.font-color: "#cdd6f4"

  shell: "BaseNodeShell\nNodeResizer + selected state\nCategory color + health band" {
    style.fill: "#313244"
    style.stroke: "#f9e2af"
    style.font-color: "#cdd6f4"
  }

  pipeline: "Pipeline (8)\nprompt_input, hidden_state_cloud\nfeature_bars, persistence_diagram\nconfidence_gauge, bridge_monitor\nexplain_waterfall, drift_matrix" {
    style.fill: "#313244"
    style.font-color: "#cba6f7"
  }
  research: "Research (7)\nlf_coordinator, lf_stage\nlf_stats, lf_autorel\nresearch_coordinator, research_bridge\nlf_pipeline_group" {
    style.fill: "#313244"
    style.font-color: "#fab387"
  }
  r2: "Research v2 (5)\nr2_bridge, r2_coordinator\nr2_stats, r2_autorel, r2_state" {
    style.fill: "#313244"
    style.font-color: "#a6e3a1"
  }

  pipeline -> shell: wraps
  research -> shell: wraps
  r2 -> shell: wraps
}

charts: Charts {
  style.fill: "#1e1e2e"
  style.stroke: "#89b4fa"
  style.font-color: "#cdd6f4"

  ts: TimeSeriesChart {style.fill: "#313244"; style.font-color: "#cdd6f4"}
  dist: DistributionChart {style.fill: "#313244"; style.font-color: "#cdd6f4"}
  stats: StatsSummary {style.fill: "#313244"; style.font-color: "#cdd6f4"}
}

linkforge: LinkForge UI {
  style.fill: "#1e1e2e"
  style.stroke: "#fab387"
  style.font-color: "#cdd6f4"

  card: PaperCard {style.fill: "#313244"; style.font-color: "#cdd6f4"}
  detail_view: PaperDetail {style.fill: "#313244"; style.font-color: "#cdd6f4"}
  pool: PaperPool {style.fill: "#313244"; style.font-color: "#cdd6f4"}
}

stores: State Management {
  style.fill: "#1e1e2e"
  style.stroke: "#f9e2af"
  style.font-color: "#cdd6f4"

  canvas_store: "canvas-store (Zustand + zundo)\nnodes, edges, graphId, graphVersion\nsaveGraph(), loadGraph(), batchUpdateNodeData()" {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }
  ui_store: "ui-store\nsplitPaneRatio, eventLogOpen\nselectedNodeId" {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }
  drift_store: "drift-store\nbaselines, alerts, PSI values" {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }
  event_log_store: "event-log-store\nstream events, filters" {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }
}

hooks: Hooks {
  style.fill: "#1e1e2e"
  style.stroke: "#a6e3a1"
  style.font-color: "#cdd6f4"

  history: "useNodeHistory\ntime-windowed data buffer" {style.fill: "#313244"; style.font-color: "#cdd6f4"}
  node_stats: "useNodeStats\nagg stats from history" {style.fill: "#313244"; style.font-color: "#cdd6f4"}
}

ws_client: "SubstrateWS (client.ts)\nExponential backoff (1s→10s)\nRAF coalescing\nAuto-resubscribe on reconnect" {
  style.fill: "#1e1e2e"
  style.stroke: "#a6e3a1"
  style.font-color: "#cdd6f4"
}

app -> tabbar
tabbar -> splitpane
splitpane -> canvas_wrapper: top
splitpane -> linkforge.pool: "bottom (Research)"
canvas_wrapper.rf -> nodes: renders
canvas_wrapper.detail -> charts: uses {style.stroke-dash: 3}
canvas_wrapper.detail -> hooks: uses {style.stroke-dash: 3}
app -> ws_client: creates
app -> stores.canvas_store: reads/writes
ws_client -> stores.canvas_store: "batchUpdateNodeData()\nvia RAF" {style.stroke-dash: 3}
ws_client -> stores.event_log_store: "stream events" {style.stroke-dash: 3}
