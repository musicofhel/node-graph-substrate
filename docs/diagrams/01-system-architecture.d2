direction: down

title: {
  label: System Architecture
  near: top-center
  shape: text
  style.font-size: 28
  style.bold: true
}

browser: Browser {
  style.fill: "#1e1e2e"
  style.stroke: "#89b4fa"
  style.font-color: "#cdd6f4"

  react: "React Flow Canvas\nPipeline | Research | Research v2" {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }
  ws_client: "SubstrateWS Client\nthrottled flush + auto-resubscribe" {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }
  react -> ws_client: "state updates" {
    style.stroke-width: 2
    style.font-color: "#cdd6f4"
  }
}

vite: "Vite Dev Server :5173\n(native WSL2 — not Docker)" {
  style.fill: "#313244"
  style.stroke: "#89b4fa"
  style.font-color: "#cdd6f4"
}

docker: Docker Compose {
  style.fill: "#11111b"
  style.stroke: "#a6e3a1"
  style.font-color: "#cdd6f4"

  server: "FastAPI Server :8080" {
    style.fill: "#1e1e2e"
    style.stroke: "#a6e3a1"
    style.font-color: "#cdd6f4"

    http: HTTP Routes {
      style.fill: "#313244"
      style.font-color: "#cdd6f4"
    }
    ws_handler: WS Handler {
      style.fill: "#313244"
      style.font-color: "#cdd6f4"
    }
    streamhub: StreamHub {
      style.fill: "#313244"
      style.stroke: "#f9e2af"
      style.font-color: "#cdd6f4"
    }
    registry: ComponentRegistry {
      style.fill: "#313244"
      style.font-color: "#cdd6f4"
    }

    ws_handler -> streamhub: "subscribe" {
      style.stroke-width: 2
      style.font-color: "#cdd6f4"
    }
  }

  postgres: "PostgreSQL 16 :5434" {
    style.fill: "#1e1e2e"
    style.stroke: "#89b4fa"
    style.font-color: "#cdd6f4"
    shape: cylinder
  }

  redis: "Redis 7 :6381" {
    style.fill: "#1e1e2e"
    style.stroke: "#f38ba8"
    style.font-color: "#cdd6f4"
    shape: cylinder
  }

  daemon: "TopoConf Daemon (opt-in)" {
    style.fill: "#1e1e2e"
    style.stroke: "#cba6f7"
    style.font-color: "#cdd6f4"
    style.stroke-dash: 3

    adapter: "TopoBridge\nwraps topo-confidence (RO mount)" {
      style.fill: "#313244"
      style.font-color: "#cdd6f4"
    }
  }

  server.http -> postgres: "asyncpg CRUD" {
    style.stroke: "#89b4fa"
    style.stroke-width: 2
    style.font-color: "#cdd6f4"
  }
  server.streamhub -> redis: "XREAD BLOCK" {
    style.stroke: "#f38ba8"
    style.stroke-width: 2
    style.font-color: "#cdd6f4"
  }
  daemon.adapter -> redis: "XADD (23 streams)" {
    style.stroke: "#cba6f7"
    style.stroke-width: 2
    style.font-color: "#cdd6f4"
  }
  daemon.adapter <- redis: "XREAD control" {
    style.stroke: "#cba6f7"
    style.stroke-width: 2
    style.stroke-dash: 3
    style.font-color: "#cdd6f4"
  }
}

browser -> vite: "HTTP :5173" {
  style.stroke: "#89b4fa"
  style.stroke-width: 2
  style.font-color: "#cdd6f4"
}
browser.ws_client -> docker.server.ws_handler: "WS /ws/canvas/{id}" {
  style.stroke: "#a6e3a1"
  style.stroke-width: 2
  style.font-color: "#cdd6f4"
}
browser.ws_client <- docker.server.ws_handler: "stream_event\ncomputation_result\ngraph_loaded" {
  style.stroke: "#a6e3a1"
  style.stroke-width: 2
  style.stroke-dash: 3
  style.font-color: "#cdd6f4"
}
