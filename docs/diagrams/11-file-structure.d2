direction: down

title: {
  label: Project File Structure
  near: top-center
  shape: text
  style.font-size: 28
  style.bold: true
}

config: "Root Config\ndocker-compose.yml\nsynthetic_daemon.py\nsynthetic_linkforge.py\nCLAUDE.md, SPEC.md" {
  style.fill: "#313244"
  style.stroke: "#585b70"
  style.font-color: "#cdd6f4"
}

migrations: "migrations/\n001_init.sql\n002_schema_fixes.sql" {
  style.fill: "#313244"
  style.stroke: "#f9e2af"
  style.font-color: "#cdd6f4"
}

server: "server/substrate/" {
  style.fill: "#1e1e2e"
  style.stroke: "#a6e3a1"
  style.font-color: "#cdd6f4"

  core: "Core (9 modules)\nmain.py — FastAPI + WS handler\ndb.py — asyncpg pool + migrations\ncrud.py — queries + optimistic lock\nws.py — ConnectionManager\nstreamhub.py — Redis stream readers\nsdk.py — Component base class\nregistry.py — ComponentRegistry\nschemas.py, messages.py" {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }

  components: "components/ (13 registered)\nprompt_input.py (COMPUTED)\n12 SUBSCRIBER components" {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }
}

frontend: "frontend/src/" {
  style.fill: "#1e1e2e"
  style.stroke: "#89b4fa"
  style.font-color: "#cdd6f4"

  canvas: "components/canvas/ (6 files)\nSubstrateCanvas, TabBar, SplitPane\nCanvasControls, PipelineTimeline\nnode-types.ts (20 type mappings)" {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }

  nodes: "components/nodes/ (23 files)\nBaseNodeShell + Sparkline\n8 Pipeline + 7 Research + 5 R2\nDriftMatrix + PaperPoolSection" {
    style.fill: "#313244"
    style.stroke: "#f38ba8"
    style.font-color: "#cdd6f4"
  }

  panels: "components/panels/\nDetailPanel (420px, 4 tabs)\nEventLog" {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }

  lib: "lib/\nws/client.ts — SubstrateWS\nstore/ — 4 Zustand stores\nhooks/ — useNodeHistory, useNodeStats\ndrift/psi.ts, layout/elk-*" {
    style.fill: "#313244"
    style.font-color: "#cdd6f4"
  }

  linkforge: "components/linkforge/\nPaperPool, PaperCard, PaperDetail" {
    style.fill: "#313244"
    style.stroke: "#fab387"
    style.font-color: "#cdd6f4"
  }
}

daemons: "daemons/topoconf/\nadapter.py — TopoBridge (7 stages)\ntopoconf_daemon.py — XREAD loop" {
  style.fill: "#313244"
  style.stroke: "#cba6f7"
  style.font-color: "#cdd6f4"
}

tests: "tests/visual/\nrun_visual_tests.py (19 specs)\nspecs/*.yaml per node" {
  style.fill: "#313244"
  style.stroke: "#f9e2af"
  style.font-color: "#cdd6f4"
}

config -> migrations: "" {style.stroke: "#585b70"; style.stroke-width: 1}
